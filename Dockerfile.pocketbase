FROM alpine:3.20

ENV PB_VERSION=0.36.1
ENV PB_DIR=/pb

RUN apk add --no-cache ca-certificates curl unzip \
  && mkdir -p "${PB_DIR}" \
  && curl -L "https://github.com/pocketbase/pocketbase/releases/download/v${PB_VERSION}/pocketbase_${PB_VERSION}_linux_amd64.zip" -o /tmp/pocketbase.zip \
  && unzip /tmp/pocketbase.zip -d "${PB_DIR}" \
  && rm /tmp/pocketbase.zip \
  && apk del curl unzip

WORKDIR ${PB_DIR}

# Application data (SQLite DB, logs, etc.)
VOLUME ["/pb/pb_data"]

# Copy JS migrations with collections snapshot
COPY pb_migrations ./pb_migrations

EXPOSE 8090

CMD ["./pocketbase", "serve", "--http=0.0.0.0:8090", "--dir=/pb/pb_data"]

